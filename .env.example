# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# n8n (self-hosted o cloud)
N8N_BASE_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=your-webhook-secret

# WhatsApp + Instagram (Meta Cloud API)
WA_PHONE_NUMBER_ID=your-phone-number-id
WA_ACCESS_TOKEN=your-permanent-access-token
WA_VERIFY_TOKEN=your-webhook-verify-token

# Email (Resend - resend.com)
RESEND_API_KEY=re_your_api_key
EMAIL_FROM=Hotel Dionys <reservas@tudominio.com>

# Cron security (Vercel cron jobs)
CRON_SECRET=your-cron-secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
